# Email Builder — noms des variables serveur (aucune valeur réelle ici ; jamais de NEXT_PUBLIC_*).

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Export HTML : origine HTTPS publique qui sert public/ (images, icônes, logo)
EMAIL_ASSETS_BASE_URL=

# Lancement depuis le HCC (docs/POC_INTEGRATION_HCC.md) — une configuration par environnement
# Origine du HCC, sans chemin (https ; http://localhost hors production seulement)
HCC_API_URL=
# Identifiant du client Builder enregistré côté HCC (ex. email-builder-local)
HCC_CLIENT_ID=
# kid et clé HMAC partagés avec le HCC (clé base64url, 32 octets au moins)
HCC_SIGNING_KEY_ID=
HCC_SIGNING_KEY=
# Secret propre au Builder (base64url, 32 octets au moins), distinct de HCC_SIGNING_KEY : dérive les clés PKCE et cookies
BUILDER_SESSION_SECRET=
